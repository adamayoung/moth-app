    "RESPONSE_FAILED_TIMEOUT" : {
      "comment" : "Response pane title when the server took too long to answer.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Request Timed Out"
          }
        }
      }
    },
    "RESPONSE_NOTE_BODY_NOT_SENT_%@" : {
      "comment" : "Shown above a response when a request's body was left off, because Moth can't send one with that method. The argument is the HTTP method, such as GET.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent without its body, because Moth can’t send a body with %@."
          }
        }
      }
    },
    "RESPONSE_NOTE_DIGEST_CHALLENGE_AFTER_REDIRECT" : {
      "comment" : "Shown above a 401 response when the request has Digest auth but the challenge came after a redirect Moth can't answer safely: to another site, or for a request with a body, so nothing more was sent.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not sent again, because the Digest challenge came after a redirect."
          }
        }
      }
    },
    "RESPONSE_NOTE_DIGEST_CHALLENGE_UNSUPPORTED" : {
      "comment" : "Shown above a 401 response when the request has Digest auth but the server's Digest challenge uses an algorithm or protection Moth can't answer, so nothing more was sent.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server’s Digest challenge isn’t supported."
          }
        }
      }
    },
    "RESPONSE_NOTE_DIGEST_SENT_AGAIN" : {
      "comment" : "Shown above a response when the server answered the first send with a Digest challenge, so Moth sent the request once more with the answer. The response shown is the second one.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent again to answer a Digest challenge."
          }
        }
      }
    },
    "RESPONSE_NOTE_EMPTY_FIELD_NAME_%@" : {
      "comment" : "Shown above a response when one form field was left out, because a variable in its name resolved to nothing. The argument is its name as the tab shows it. RESPONSE_NOTE_EMPTY_FIELD_NAMES_%lld covers several.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent without field %@, because its name is empty."
          }
        }
      }
    },
    "RESPONSE_NOTE_EMPTY_FIELD_NAMES_%lld" : {
      "comment" : "Shown above a response when form fields were left out, because variables in their names resolved to nothing. The argument is how many. RESPONSE_NOTE_EMPTY_FIELD_NAME_%@ covers one, by name.",
      "localizations" : {
        "en-GB" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Sent without %lld field, because its name is empty."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Sent without %lld fields, because their names are empty."
                }
              }
            }
          }
        }
      }
    },
    "RESPONSE_NOTE_EMPTY_HEADER_NAME_%@" : {
      "comment" : "Shown above a response when one header was left out, because a variable in its name resolved to nothing. The argument is its name as the tab shows it. RESPONSE_NOTE_EMPTY_HEADER_NAMES_%lld covers several.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent without header %@, because its name is empty."
          }
        }
      }
    },
    "RESPONSE_NOTE_EMPTY_HEADER_NAMES_%lld" : {
      "comment" : "Shown above a response when headers were left out, because variables in their names resolved to nothing. The argument is how many. RESPONSE_NOTE_EMPTY_HEADER_NAME_%@ covers one, by name.",
      "localizations" : {
        "en-GB" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Sent without %lld header, because its name is empty."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Sent without %lld headers, because their names are empty."
                }
              }
            }
          }
        }
      }
    },
    "RESPONSE_NOTE_EMPTY_QUERY_PARAMETER_NAME_%@" : {
      "comment" : "Shown above a response when one query parameter was left out, because a variable in its name resolved to nothing. The argument is its name as the tab shows it. RESPONSE_NOTE_EMPTY_QUERY_PARAMETER_NAMES_%lld covers several.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent without query parameter %@, because its name is empty."
          }
        }
      }
    },
    "RESPONSE_NOTE_EMPTY_QUERY_PARAMETER_NAMES_%lld" : {
      "comment" : "Shown above a response when query parameters were left out, because variables in their names resolved to nothing. The argument is how many. RESPONSE_NOTE_EMPTY_QUERY_PARAMETER_NAME_%@ covers one, by name.",
      "localizations" : {
        "en-GB" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Sent without %lld query parameter, because its name is empty."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Sent without %lld query parameters, because their names are empty."
                }
              }
            }
          }
        }
      }
    },
    "RESPONSE_NOTE_FORM_DATA_BOUNDARY_REPLACED" : {
      "comment" : "Shown above a response when a manual Content-Type header stood in for the one that names a form-data body's boundary.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Content-Type header replaced the form-data boundary, so the server may not read the body."
          }
        }
      }
    },
    "RESPONSE_NOTE_MISSING_CREDENTIAL" : {
      "comment" : "Shown above a response when the request's password, token or API key has no stored value or no name, so it went out with no auth.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent without auth, because its credential has no value."
          }
        }
      }
    },
    "RESPONSE_NOTE_PATH_VARIABLES_WITHOUT_VALUES_%lld" : {
      "comment" : "Shown above a response when path variables had no value, so the URL went out with them as written. The argument is how many. RESPONSE_NOTE_PATH_VARIABLE_WITHOUT_VALUE_%@ covers one, by name.",
      "localizations" : {
        "en-GB" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld path variable has no value and was sent as written."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld path variables have no value and were sent as written."
                }
              }
            }
          }
        }
      }
    },
    "RESPONSE_NOTE_PATH_VARIABLE_WITHOUT_VALUE_%@" : {
      "comment" : "Shown above a response when one path variable had no value, so the URL went out with it as written. The argument is its name without the colon, as the tab shows it. RESPONSE_NOTE_PATH_VARIABLES_WITHOUT_VALUES_%lld covers several.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ":%@ has no value, so it was sent as written."
          }
        }
      }
    },
    "RESPONSE_NOTE_SECRET_WITHOUT_VALUE_%@" : {
      "comment" : "Shown above a response when one variable is a secret with no stored value. The argument is its name. RESPONSE_NOTE_UNRESOLVED_VARIABLES_%lld covers several.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{%@}} is a secret with no value, so it was sent as written."
          }
        }
      }
    },
    "RESPONSE_NOTE_UNDEFINED_VARIABLE_%@" : {
      "comment" : "Shown above a response when one variable is undefined. The argument is its name. RESPONSE_NOTE_UNDEFINED_VARIABLES_%lld covers several.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{%@}} isn’t defined, so it was sent as written."
          }
        }
      }
    },
    "RESPONSE_NOTE_UNDEFINED_VARIABLES_%lld" : {
      "comment" : "Shown above a response when several variables are all undefined. The argument is how many. RESPONSE_NOTE_UNDEFINED_VARIABLE_%@ covers one, by name, and RESPONSE_NOTE_UNRESOLVED_VARIABLES_%lld covers a mix of reasons.",
