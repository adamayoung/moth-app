    "SIDEBAR_DELETE_CONTAINER_MESSAGE_%lld" : {
      "comment" : "Message of the alert that confirms deleting a collection or folder. The argument is how many requests the delete removes.",
      "localizations" : {
        "en-GB" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This deletes its %lld request. You can’t undo this."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This deletes its %lld requests. You can’t undo this."
                }
              }
            }
          }
        }
      }
    },
    "SIDEBAR_DELETE_ENVIRONMENT_MESSAGE_%lld" : {
