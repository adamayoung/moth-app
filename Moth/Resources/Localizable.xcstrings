    },
    "RESPONSE_NOTE_UNSENDABLE_HEADERS_%lld" : {
      "comment" : "Shown above a response when several headers were left out, because their names or values aren't valid in HTTP. The argument is how many. RESPONSE_NOTE_UNSENDABLE_HEADER_%@ covers one, by name.",
