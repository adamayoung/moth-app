        }
      }
    },
    "RESPONSE_NOTE_UNRESOLVED_VARIABLES_%lld" : {
      "comment" : "Shown above a response when several variables had no value, and not all because they are undefined. The argument is how many. RESPONSE_NOTE_UNDEFINED_VARIABLES_%lld covers several that are all undefined.",
      "localizations" : {
        "en-GB" : {
          "variations" : {
            "plural" : {
