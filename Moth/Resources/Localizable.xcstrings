    "RESPONSE_NOTE_UNSENDABLE_HEADER_%@" : {
      "comment" : "Shown above a response when one header was left out, because its name or value isn't valid in HTTP. The argument is its name. RESPONSE_NOTE_UNSENDABLE_HEADERS_%lld covers several.",
