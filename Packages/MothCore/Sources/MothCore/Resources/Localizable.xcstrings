{
  "sourceLanguage" : "en-GB",
  "strings" : {
    "OAUTH2_SIGN_IN_ERROR_CALLBACK_SCHEME" : {
      "comment" : "Shown under an OAuth 2.0 Callback URL, and under “Couldn’t Get Access Token”, when the Callback URL is http, https or not a URL. A URL scheme is the part before the colon, such as moth in moth://.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moth can only receive a sign-in at a custom URL scheme."
          }
        }
      }
    },
    "OAUTH2_SIGN_IN_ERROR_INVALID_URL" : {
      "comment" : "Shown under “Couldn’t Get Access Token” when the OAuth 2.0 Auth URL isn’t an http or https address, so no sign-in opens.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Auth URL isn’t a valid web address."
          }
        }
      }
    },
    "OAUTH2_SIGN_IN_ERROR_NO_CODE" : {
      "comment" : "Shown under “Couldn’t Get Access Token” when an OAuth 2.0 sign-in’s callback has no code.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sign-in returned no authorization code."
          }
        }
      }
    },
    "OAUTH2_SIGN_IN_ERROR_STATE" : {
      "comment" : "Shown under “Couldn’t Get Access Token” when an OAuth 2.0 sign-in’s callback carries a state value other than the one Moth sent. “state” is the OAuth parameter’s name.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sign-in answered with a different state, so Moth didn’t ask for a token."
          }
        }
      }
    },
    "OAUTH2_TOKEN_ERROR_EXPIRED" : {
      "comment" : "Shown under “Couldn’t Get Access Token” when a send finds the OAuth 2.0 token expired and it can’t be refreshed. “Get New Access Token” is the button that signs in again.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token Expired. Get a new access token."
          }
        }
      }
    },
    "OAUTH2_TOKEN_ERROR_INVALID_URL" : {
      "comment" : "Shown under “Couldn’t Get Access Token” when an OAuth 2.0 Token URL can't be requested.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The token URL isn’t a valid http or https URL."
          }
        }
      }
    },
    "OAUTH2_TOKEN_ERROR_NO_TOKEN" : {
      "comment" : "Shown under “Couldn’t Get Access Token” when the token endpoint succeeded but sent no access_token.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The token endpoint’s answer had no access token."
          }
        }
      }
    },
    "OAUTH2_TOKEN_ERROR_OTHER_FIELDS" : {
      "comment" : "Shown under “Couldn’t Get Access Token” when the stored OAuth 2.0 token was issued for other fields, such as another environment’s Token URL. Token URL, Client ID and Scope are field labels.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The token was issued for another Token URL, Client ID or Scope. Get a new access token."
          }
        }
      }
    },
    "OAUTH2_TOKEN_ERROR_SIGN_IN_NEEDED" : {
      "comment" : "Shown under “Couldn’t Get Access Token” when a send under the OAuth 2.0 Authorization Code grant has no token, because only Get New Access Token can sign in.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Token. Get a new access token."
          }
        }
      }
    },
    "OAUTH2_TOKEN_ERROR_STATUS_%lld" : {
      "comment" : "Shown under “Couldn’t Get Access Token” when the token endpoint refused with no OAuth error. The argument is the HTTP status code, not a count.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The token endpoint answered %lld."
          }
        }
      }
    },
    "OAUTH2_TOKEN_ERROR_UNSUPPORTED_GRANT" : {
      "comment" : "Shown under “Couldn’t Get Access Token” when the auth's grant type has no token request in Moth.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moth can’t get a token for this grant type yet."
          }
        }
      }
    },
    "REQUEST_BUILD_INCOMPLETE_AWS_SIGNATURE" : {
      "comment" : "Shown when a request cannot be sent because an AWS Signature field is empty.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AWS Signature needs an access key, secret key, region and service."
          }
        }
      }
    },
    "REQUEST_BUILD_INVALID_API_KEY" : {
      "comment" : "Shown when a request cannot be sent because its API Key name or value has characters a header cannot hold, such as a line break.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This API key can’t be sent in a header."
          }
        }
      }
    },
    "REQUEST_BUILD_INVALID_BEARER_TOKEN" : {
      "comment" : "Shown when a request cannot be sent because its Bearer token has characters a header cannot hold, such as a line break.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This token can’t be sent in a header."
          }
        }
      }
    },
    "REQUEST_BUILD_INVALID_METHOD" : {
      "comment" : "Shown when a request cannot be sent because its HTTP method is empty or has characters a method cannot hold.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This method isn’t valid."
          }
        }
      }
    },
    "REQUEST_BUILD_INVALID_URL" : {
      "comment" : "Shown when a request cannot be sent because its URL is empty or invalid.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This URL isn’t valid."
          }
        }
      }
    },
    "REQUEST_BUILD_UNSENDABLE_AWS_SIGNATURE" : {
      "comment" : "Shown when a request cannot be sent because an AWS Signature field has characters a header cannot hold, such as a line break.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This AWS Signature can’t be sent in a header."
          }
        }
      }
    },
    "REQUEST_SEND_NOT_FOUND" : {
      "comment" : "Shown when a request cannot be sent because its row has gone, such as after a delete on another Mac.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This request no longer exists."
          }
        }
      }
    },
    "REQUEST_SEND_UNREADABLE_INHERITED_AUTH" : {
      "comment" : "Shown when a request cannot be sent because a folder or collection it inherits auth from can't be read.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The auth this request inherits can’t be read."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
