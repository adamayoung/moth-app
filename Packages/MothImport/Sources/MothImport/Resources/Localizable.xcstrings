        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skipped %@."
          }
        }
      }
    },
    "IMPORT_SKIPPED_AUTH_%lld_%@" : {
      "comment" : "One item in the skipped list: auth Moth could not keep. The first argument is the number dropped, the second the name of the auth scheme.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@auths@"
