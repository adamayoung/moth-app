    "CODE_NOTE_API_KEY_NAME" : {
      "comment" : "A comment in generated code, for a request whose API key auth has no name.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The API key is left out, because it has no name."
          }
        }
      }
    },
    "CODE_NOTE_AWS" : {
      "comment" : "A comment in generated code, for a request that signs with AWS Signature auth.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AWS Signature auth is left out of this code."
          }
        }
      }
    },
    "CODE_NOTE_BODY_%@" : {
      "comment" : "A comment in generated code, for a body that the request's method doesn't send. The argument is the method, such as GET.",
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The body is left out, because %@ doesn’t send one."
