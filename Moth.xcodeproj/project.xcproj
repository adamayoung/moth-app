{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": "Configs/Debug.xcconfig" },
    { "name": "Release", "file": "Configs/Release.xcconfig" },
  ],
  "localizations": {
    "development": "en-GB",
    "supported": [
      "Base",
    ],
  },
  "files": [
    {
      "kind": "group",
      "path": "Configs",
      "children": [
        { "path": "Debug.xcconfig" },
        { "path": "Info.plist" },
        { "path": "Local.xcconfig.example" },
        { "path": "MothICloud.entitlements" },
        { "path": "Release.xcconfig" },
        { "path": "Shared.xcconfig" },
      ],
    },
    { "kind": "folder", "path": "Moth", "target-membership": [ "Moth" ] },
    { "kind": "folder", "path": "Packages" },
    {
      "kind": "folder",
      "path": "MothTests",
      "target-membership": [
        "MothTests",
      ],
      "membership-exceptions": [
        {
          "target": "MothTests",
          "exclusions": [
            ".swiftformat",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "MothUITests",
      "target-membership": [
        "MothUITests",
      ],
      "membership-exceptions": [
        {
          "target": "MothUITests",
          "exclusions": [
            ".swiftformat",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Moth.app", "id": "6638539A309BDC9600B9519C", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/MothTests.xctest", "id": "663853A9309BDC9700B9519C", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/MothUITests.xctest", "id": "663853B3309BDC9700B9519C", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Moth",
      "id": "66385399309BDC9600B9519C",
      "product": "Products/Moth.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "HTTPKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MothCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MothImport",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "$(MOTH_APP_ENTITLEMENTS)",
        "COMBINE_HIDPI_IMAGES": "YES",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_INCOMING_NETWORK_CONNECTIONS": "NO",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SELECTED_FILES": "readonly",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Configs/Info.plist",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "uk.co.adam-young.Moth",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
      },
    }, {
      "name": "MothTests",
      "id": "663853A8309BDC9700B9519C",
      "product": "Products/MothTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "Moth",
      "dependencies": [
        "Moth",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "uk.co.adam-young.MothTests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "NO",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Moth.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Moth",
      },
    }, {
      "name": "MothUITests",
      "id": "663853B2309BDC9700B9519C",
      "product": "Products/MothUITests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "Moth",
      "dependencies": [
        "Moth",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "uk.co.adam-young.MothUITests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "NO",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "TEST_TARGET_NAME": "Moth",
      },
    },
  ],
  "last-upgrade": "27.2",
  "last-swift-update": "27.2",
}
